# Godot
.godot/
*.import
**/.godot/
# generated output
demo/out*/
tests/out/
tests/**/out*/
*.tmp
# python
__pycache__/
*.pyc
# os
Thumbs.db
.venv/
**/.venv/
*.wav
*.blend1
# synced copies of library files inside demo / test projects (regenerated by sync scripts)
demo/assets/
demo/audio/
demo/lib/
demo/bottle_*.gd*
demo/bottle_*.gdshader*
demo/liquid_lut_v2.gd*
tests/*/assets/
tests/*/audio/
tests/*/lib/
tests/*/bottle_*.gd
tests/*/bottle_*.gd.uid
tests/*/bottle_*.gdshader*
tests/*/liquid_lut_v2.gd*
# grasp fit tool output (extensions/grasp/tools/fit_baked_thumbs.mjs; regenerate, then apply_grasp_fit.mjs)
extensions/grasp/tools/scratch/
# character-cc generated folders (sync_cc.mjs); only the games hold them
extensions/character-cc/assets/
extensions/character-cc/vendor/
# character-vrm test models (fetch_model.mjs downloads them; sha256 in models.js), never committed
extensions/character-vrm/assets/
