    "test:bar-fire:browser": "node scripts/bar-fire-smoke.mjs",
    "test:pistol:browser": "node scripts/pistol-smoke.mjs",
    "test:missions:browser": "node scripts/mission-smoke.mjs",
    "test:fire:browser": "node scripts/fire-smoke.mjs",
    "test:flow:browser": "node scripts/flow-smoke.mjs",
    "test:coatings:browser": "node scripts/coatings-smoke.mjs",
    "test:lifecycle:browser": "node scripts/lifecycle-smoke.mjs",
    "test:pools:browser": "node scripts/pool-budget-smoke.mjs",
