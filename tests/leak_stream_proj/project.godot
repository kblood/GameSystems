config_version=5

[application]
config/name="leak_stream_test"
run/main_scene="res://leak_test.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]
QualityTier="*res://lib/quality_tier.gd"
AudioHub="*res://lib/audio_hub.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720

[layer_names]
3d_physics/layer_1="world"
3d_physics/layer_2="props"
3d_physics/layer_4="bottles"
3d_physics/layer_20="shards"

[rendering]
renderer/rendering_method="forward_plus"

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/penetration_slop=0.002
