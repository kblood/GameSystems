{
  "$schema": "../docs/bottle_design.schema.json",
  "bottle": "wine",
  "glass": {
    "tint": [
      0.05,
      0.22,
      0.08,
      1.0
    ],
    "roughness": 0.03,
    "thickness_mm": 3
  },
  "cap": {
    "type": "cork"
  },
  "liquid": {
    "color": [
      0.35,
      0.02,
      0.06,
      1.0
    ],
    "fill": 0.7,
